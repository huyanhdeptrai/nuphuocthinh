# Environment variables example
# Copy this file to .env.local and update the values as needed

# Node
NODE_ENV=development

# Public
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server
DATABASE_URL="postgresql://lemyloi-dichvideo:***@localhost:5432/lemyloi-dichvideo"
BETTER_AUTH_SECRET=your_better_auth_secret

UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=lemyloi-dichvideo_redis_token

FREESOUND_CLIENT_ID=your_client_id_here
FREESOUND_API_KEY=your_api_key_here

# Cloudflare R2 (for reference image uploads)
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
R2_PUBLIC_URL=https://your-r2-public-url.example.com

# Gói GPU (CUDA) — tải từ GitHub Releases khi user bật GPU.
# Bỏ trống để dùng release công khai mặc định của Editkub.
# EDITKUB_GPU_MANIFEST_URL=https://github.com/OWNER/REPO/releases/download/gpu-2.8.0-cu126/manifest.json
EDITKUB_GPU_MANIFEST_URL=

# ASR / speaker diarization
# none, speech-band, or speech-denoise
ASR_AUDIO_FILTER_PRESET=none
LEMYLOI_DICHVIDEO_ANALYSIS_CACHE_DIR=
DIARIZATION_PYTHON=
PYANNOTE_MODEL_PATH=
# community-1 native step is 0.5 (faster, coarser). 0.1 is the accuracy default.
PYANNOTE_SEGMENTATION_STEP=0.1
PYANNOTE_MODEL_FINGERPRINT=community-1-step-0.1
